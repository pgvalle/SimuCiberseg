{
  "program": "p4drop-ext.p4",
  "language": "p4-16",
  "targets": {
    "multiswitch": {
      "auto-control-plane": true,
      "pcap_dump": true,
      "switches": {
        "s1": {
          "commands": [
            "s1-commands.txt"
          ]
        }
      },
      "links": [
        [
          "h1",
          "s1"
        ],
        [
          "h2",
          "s1"
        ]
      ],
      "hosts": {
        "h2": {
          "cmd": "python server.py 8000",
          "startup_sleep": 0.2,
          "wait": false
        },
        "h1": {
          "cmd": "python send_spoofed_single.py 10.0.2.101 8000 && sleep 5",
          "wait": true
        }
      }
    }
  }
}