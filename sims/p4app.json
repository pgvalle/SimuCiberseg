{
  "program": "p4drop-ext.p4",
  "language": "p4-16",
  "targets": {
    "multiswitch": {
      "auto-control-plane": true,
      "pcap_dump": true,
      "switches": {
        "s1": {
          "commands": [
            "s1-commands-v6.txt"
          ]
        }
      },
      "links": [
        ["h1", "s1"],
        ["h2", "s1"]
      ],
      "hosts": {
        "h2": {
          "cmd": "python server_v6.py 8000",
          "startup_sleep": 0.2,
          "wait": false
        },
        "h1": {
          "cmd": "python send_mixed_traffic_v6.py 2001:db8:2::101 8000 50 0.0 && sleep 10",
          "wait": true
        }
      }
    }
  }
}
